{
  "name": "transmission",
  "version": "2.4.1",
  "description": "Content audit, IA, and migration workspace for website replatforms — assess every page, architect the new site, and direct the build",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "electron-builder --mac --universal",
    "build:arm": "electron-builder --mac --arm64",
    "build:intel": "electron-builder --mac --x64"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "marked": "^4.3.0",
    "mustache": "^4.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "io.github.factus10.transmission",
    "productName": "Transmission",
    "fileAssociations": [
      {
        "ext": "transmission",
        "name": "Transmission Project",
        "description": "Transmission content audit project",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": {
        "teamId": "D4YLNBMZ79"
      }
    },
    "dmg": {
      "title": "Transmission",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "project-store.js",
      "src/**/*",
      "assets/**/*",
      "rubrics/**/*",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,readme.md,*.d.ts}",
      "!node_modules/.cache"
    ]
  }
}
