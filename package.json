{
  "name": "transmission",
  "version": "2.22.1",
  "description": "Content audit, IA, and migration workspace for website replatforms \u2014 assess every page, architect the new site, and direct the build",
  "main": "main.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "electron .",
    "dev": "electron . --dev",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "electron-builder --mac --universal",
    "build:arm": "electron-builder --mac --arm64",
    "build:intel": "electron-builder --mac --x64",
    "build:signed:sandboxed": "bash scripts/build-signed-mac.sh",
    "changelog:html": "node scripts/generate-changelog-html.js",
    "docs:html": "node scripts/generate-docs-site.js",
    "skills:zip": "node scripts/package-skills.js",
    "release:publish": "bash scripts/publish-release.sh"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "marked": "^4.3.0",
    "mustache": "^4.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.factus10.transmission",
    "productName": "Transmission",
    "afterPack": "scripts/afterPack.js",
    "fileAssociations": [
      {
        "ext": "transmission",
        "name": "Transmission Project",
        "description": "Transmission content audit project",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "x64ArchFiles": "**/node_modules/better-sqlite3/prebuilds/darwin-*.node"
    },
    "dmg": {
      "title": "Transmission",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "mcp",
        "to": "mcp",
        "filter": [
          "**/*",
          "!sample/*.transmission*",
          "!**/.DS_Store"
        ]
      }
    ],
    "files": [
      "*.js",
      "src/**/*",
      "assets/**/*",
      "rubrics/**/*",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,readme.md,*.d.ts}",
      "!node_modules/.cache",
      "!node_modules/better-sqlite3/prebuilds/{linux,linuxmusl,win32}-*.node",
      "!node_modules/better-sqlite3/{deps,src}/**"
    ]
  }
}
